NODE_ENV=production
PORT=10000
HOST=0.0.0.0
APP_URL=https://YOUR-FRONTEND.onrender.com
CORS_ORIGINS=https://YOUR-FRONTEND.onrender.com
CORS_CREDENTIALS=true
SESSION_SECRET=replace-with-long-random-secret
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=experthub.sid
DB_HOST=localhost
DB_PORT=3306
DB_NAME=experthub
DB_USER=experthub_user
DB_PASSWORD=replace-me
DB_CONNECTION_LIMIT=10

# M-Pesa / Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR-BACKEND.onrender.com/api/payments/mpesa/callback

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ExpertHub <no-reply@example.com>
